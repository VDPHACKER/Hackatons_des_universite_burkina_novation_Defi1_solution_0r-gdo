<mxfile host="Orẽgdo" type="device"><diagram id="architecture" name="Architecture d&#x27;Orẽgdo"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;Téléphone : application web installable (PWA)&lt;/b&gt;&lt;br&gt;web/ : écrans par rôle (MapLibre)&lt;br&gt;Service worker : fonctionne sans réseau&lt;br&gt;IndexedDB : file d&#x27;attente des signalements&lt;br&gt;Masquage des visages et plaques sur le téléphone" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e8f5ec;strokeColor=#1e7a46;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="300" height="160" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Ordinateur de la mairie&lt;/b&gt;&lt;br&gt;même application, écrans larges&lt;br&gt;(tableau de bord, plan, simulation, jury)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e8f5ec;strokeColor=#1e7a46;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="300" height="90" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Serveur FastAPI&lt;/b&gt; (oregdo/app.py)&lt;br&gt;&lt;br&gt;api/signalements.py : dépôt, import, revalidation&lt;br&gt;api/portails.py : comptes, brigade, pré-collecteur, mairie&lt;br&gt;api/plan.py : plan, scénario, aléas, simulation&lt;br&gt;api/notifications.py&lt;br&gt;&lt;br&gt;securite.py : jetons signés, rôles, limitation de débit&lt;br&gt;comptes.py : comptes, mots de passe (scrypt)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#1e7a46;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="60" width="340" height="290" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Vérification&lt;/b&gt; (oregdo/verification)&lt;br&gt;8 contrôles, score 0-100, doublons → dépotoirs,&lt;br&gt;import CSV / Kobo / WKT / GeoJSON,&lt;br&gt;collecte simulée, jeux synthétiques" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e8f5ec;strokeColor=#1e7a46;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="40" width="330" height="110" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Planification&lt;/b&gt; (oregdo/planning)&lt;br&gt;p-médiane (HiGHS) : points de regroupement&lt;br&gt;tournées (PyVRP) sur le réseau OSM&lt;br&gt;aléas : panne, pluie, quartier, pièges" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e8f5ec;strokeColor=#1e7a46;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="170" width="330" height="110" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Simulation multi-agents&lt;/b&gt; (oregdo/simulation, Mesa)&lt;br&gt;ménages, pré-collecteurs, brigade Laabal, mairie" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e8f5ec;strokeColor=#1e7a46;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="300" width="330" height="90" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;SQLite&lt;/b&gt; data/oregdo.db&lt;br&gt;signalements, dépotoirs, comptes,&lt;br&gt;interventions, collectes, journal d&#x27;audit" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f4f6f4;strokeColor=#1e7a46;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="40" width="300" height="110" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Pack commune&lt;/b&gt; packs/ouaga/&lt;br&gt;commune_config.yaml (paramètres [S]/[H])&lt;br&gt;couches GeoJSON, graphe routier,&lt;br&gt;population (Open Buildings)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f4f6f4;strokeColor=#1e7a46;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="170" width="300" height="130" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Données ouvertes&lt;/b&gt;&lt;br&gt;OpenStreetMap, Google Open Buildings,&lt;br&gt;RGPH 2019" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f4f6f4;strokeColor=#1e7a46;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="330" width="300" height="80" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Déploiement en une commande&lt;/b&gt;&lt;br&gt;docker compose up --build&lt;br&gt;ou scripts\deployer.ps1 (Windows)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff3c4;strokeColor=#1e7a46;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="400" width="340" height="80" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Bien commun&lt;/b&gt; : export OpenStreetMap (.osm, GeoJSON ODbL)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff3c4;strokeColor=#1e7a46;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="420" width="330" height="60" as="geometry"/></mxCell><mxCell id="c14" value="HTTPS /api (JSON), synchronisation" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="HTTPS /api" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="c6" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeSt